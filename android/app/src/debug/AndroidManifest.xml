<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!-- Debug builds only: lets adb import a test configuration and start/stop the VPN. -->
        <activity
            android:name=".DebugControlActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Debug builds only: lets the test suite fire the watchdog alarm without waiting for it. -->
        <receiver
            android:name=".Watchdog"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
